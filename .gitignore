# ---- Data (excluded from the repository; see data/README.md) --------------
# Raw inputs are far too large for GitHub (up to ~720 MB per file) and are not
# redistributed here. Keep them locally under data/ but never commit them.
data/*
!data/README.md
!data/.gitkeep

# Saved workspaces / intermediate results (large binary; regenerated by scripts)
*.RData
*.Rda
*.rds
*.Rhistory

# Generated outputs — figures + figure-source-data workbook.
# Kept out of the repo because they embed study-derived values/visuals;
# regenerate locally with R/verify_figures.R and R/build_figure_source_data.R.
results/figures/*
!results/figures/.gitkeep
results/tables/*
!results/tables/.gitkeep
*.html
*_files/
*_cache/

# R / RStudio
.Rproj.user/
.Rapp.history
.DS_Store

# Large source data mistakenly placed anywhere
*.csv.gz
downloads_study310_*

# Unpublished manuscript figure PDF (kept local, not published)
figures pdf.pdf
*.pdf

# Figure-data build/harness scripts (kept local, not published)
R/extract_reap_figure_data.R
R/build_figure_source_data.R
